{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Twitter Sentiment Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "sentiment": {
        "type": "string"
      },
      "confidence": {
        "type": "number"
      }
    }
  }
}
